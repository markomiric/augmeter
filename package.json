{
  "name": "augmeter",
  "displayName": "Augmeter",
  "description": "Augment credits/usage meter for the VS Code status bar",
  "version": "1.0.3",
  "publisher": "kamacode",
  "author": {
    "name": "Marko",
    "email": "marko@kamacode.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/markomiric/augmeter"
  },
  "bugs": {
    "url": "https://github.com/markomiric/augmeter/issues"
  },
  "homepage": "https://github.com/markomiric/augmeter#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=20.0.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "augment",
    "augmeter",
    "ai",
    "usage",
    "credits",
    "meter",
    "status bar",
    "statusbar",
    "statistics",
    "credits monitor",
    "token usage",
    "cost tracking",
    "usage dashboard",
    "usage alerts",
    "augment credits",
    "augment usage"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Augmeter disables local session-file tracking in untrusted workspaces.",
      "restrictedConfigurations": [
        "augmeter.sessionTracking.enabled",
        "augmeter.sessionTracking.path"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "augmeter.manualRefresh",
        "title": "Refresh Usage",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.openSettings",
        "title": "Open Settings",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.signIn",
        "title": "Sign In",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.signOut",
        "title": "Sign Out",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.openWebsiteAndSignIn",
        "title": "Open Website and Sign In",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.copyUsageSummary",
        "title": "Copy Usage Summary",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.openUsageDashboard",
        "title": "Open Usage Dashboard",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.exportUsageHistoryCsv",
        "title": "Export Usage History (CSV)",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.runDiagnostics",
        "title": "Run Diagnostics",
        "category": "Augmeter"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "augmeter.signIn",
          "when": "!augmeter.isSignedIn"
        },
        {
          "command": "augmeter.openWebsiteAndSignIn",
          "when": "!augmeter.isSignedIn"
        },
        {
          "command": "augmeter.signOut",
          "when": "augmeter.isSignedIn"
        },
        {
          "command": "augmeter.copyUsageSummary",
          "when": "augmeter.isSignedIn"
        },
        {
          "command": "augmeter.openUsageDashboard"
        },
        {
          "command": "augmeter.exportUsageHistoryCsv",
          "when": "augmeter.isSignedIn"
        },
        {
          "command": "augmeter.runDiagnostics"
        }
      ]
    },
    "configuration": {
      "title": "Augmeter",
      "properties": {
        "augmeter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Augmeter extension"
        },
        "augmeter.refreshInterval": {
          "type": "number",
          "default": 60,
          "description": "How often to refresh usage data (in seconds, 1-300)",
          "minimum": 1,
          "maximum": 300
        },
        "augmeter.clickAction": {
          "type": "string",
          "enum": [
            "refresh",
            "openWebsite",
            "openSettings"
          ],
          "enumDescriptions": [
            "Refresh usage data immediately",
            "Open Augment website in browser",
            "Open Augmeter settings"
          ],
          "default": "refresh",
          "description": "Action to perform when clicking the status bar item"
        },
        "augmeter.displayMode": {
          "type": "string",
          "enum": [
            "used",
            "remaining",
            "remainingOnly",
            "both",
            "percentage"
          ],
          "default": "both",
          "description": "Choose how to display credits in the status bar: used/limit, remaining/limit, remainingOnly (remaining number only), both, or percentage (e.g. 60%)."
        },
        "augmeter.statusBarDensity": {
          "type": "string",
          "enum": [
            "auto",
            "compact",
            "detailed"
          ],
          "default": "auto",
          "description": "Control the density of the status bar display: auto (adaptive), compact (text only), or detailed (with icon)."
        },
        "augmeter.statusBarIcon": {
          "type": "string",
          "enum": [
            "graph-line",
            "graph",
            "dashboard",
            "pie-chart",
            "pulse",
            "percentage"
          ],
          "default": "dashboard",
          "description": "Icon to display in the status bar when density is detailed."
        },
        "augmeter.showPercentInStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show percentage context in compact status surfaces where supported."
        },
        "augmeter.colorScheme": {
          "type": "string",
          "enum": [
            "standard",
            "conservative",
            "aggressive"
          ],
          "default": "standard",
          "description": "Color sensitivity for warning thresholds."
        },
        "augmeter.colorThresholds": {
          "type": "object",
          "default": {
            "critical": 95,
            "highWarning": 85,
            "warning": 75,
            "caution": 50
          },
          "description": "Custom status bar color thresholds as percentages."
        },
        "augmeter.enhancedReadability": {
          "type": "boolean",
          "default": false,
          "description": "Use stronger foreground/background contrast in status colors."
        },
        "augmeter.autoDetectHighContrast": {
          "type": "boolean",
          "default": true,
          "description": "Automatically adapt status colors for high-contrast themes."
        },
        "augmeter.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info"
          ],
          "default": "info",
          "description": "Log verbosity for Output > Augmeter."
        },
        "augmeter.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Augmeter information in the status bar."
        },
        "augmeter.history.retentionDays": {
          "type": "number",
          "default": 35,
          "minimum": 7,
          "maximum": 90,
          "description": "How many days of usage snapshots to retain for trend and export."
        },
        "augmeter.alerts.warningPercent": {
          "type": "number",
          "default": 75,
          "minimum": 50,
          "maximum": 99,
          "description": "Usage percentage threshold for warning notifications."
        },
        "augmeter.alerts.highPercent": {
          "type": "number",
          "default": 90,
          "minimum": 60,
          "maximum": 99,
          "description": "Usage percentage threshold for high-usage notifications."
        },
        "augmeter.alerts.criticalPercent": {
          "type": "number",
          "default": 95,
          "minimum": 70,
          "maximum": 100,
          "description": "Usage percentage threshold for critical notifications."
        },
        "augmeter.alerts.runOutDays": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 30,
          "description": "Alert when projected depletion is within this many days (0 disables this alert)."
        },
        "augmeter.budget.monthlyTarget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Optional monthly usage target. Set 0 to disable."
        },
        "augmeter.apiBaseUrl": {
          "type": "string",
          "default": "https://app.augmentcode.com/api",
          "description": "Base URL for the Augment API (useful for staging/tenant overrides).",
          "scope": "application"
        },
        "augmeter.sessionTracking.enabled": {
          "type": "boolean",
          "default": false,
          "description": "(Experimental) Enable session activity tracking from local Augment session files."
        },
        "augmeter.sessionTracking.path": {
          "type": "string",
          "default": "",
          "description": "(Experimental) Custom path to Augment sessions directory. Leave empty for default (~/.augment/sessions)."
        },
        "augmeter.smartSignIn.quickWatchMs": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "maximum": 5000,
          "description": "Smart Sign-In: how long to watch the clipboard for a session cookie before falling back to opening the website (milliseconds). Set 0 to disable quick watch.",
          "scope": "application"
        },
        "augmeter.smartSignIn.websiteWatchMs": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Smart Sign-In: how long to watch the clipboard for a session cookie after opening the website (milliseconds, default 5 minutes).",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile-tests": "tsc -p . --outDir out --sourceMap true",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package",
    "clean": "rimraf out *.vsix",
    "sbom": "cyclonedx-npm --output-file sbom.json",
    "pretest": "npm run compile && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run src/unit",
    "test:integration": "vscode-test",
    "test:all": "npm run test:cov && npm run test:integration",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "docs": "typedoc --out docs/api src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "analyze:knip": "knip --reporter json --no-progress",
    "analyze:prune": "ts-prune -p tsconfig.json || true",
    "analyze:depcheck": "depcheck --json || true",
    "analyze:jscpd": "jscpd --silent --reporters json --min-lines 12 --threshold 0 src || true"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.0.3",
    "@types/node": "^20.19.13",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "depcheck": "^1.4.7",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "knip": "^5.64.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-prune": "^0.10.3",
    "typedoc": "^0.28.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {},
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.{js,mjs}": [
      "prettier --write"
    ]
  }
}

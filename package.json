{
  "name": "augmeter",
  "displayName": "Augmeter: Assistant Usage",
  "description": "See coding-assistant activity and connected provider usage in one VS Code view.",
  "version": "1.1.0",
  "publisher": "kamacode",
  "author": "Marko",
  "repository": {
    "type": "git",
    "url": "https://github.com/markomiric/augmeter"
  },
  "bugs": {
    "url": "https://github.com/markomiric/augmeter/issues"
  },
  "homepage": "https://github.com/markomiric/augmeter#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=20.18.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "ai usage",
    "coding assistant",
    "claude code",
    "codex",
    "github copilot",
    "copilot",
    "openai",
    "augment",
    "augmeter",
    "credits",
    "token usage",
    "usage meter",
    "usage dashboard",
    "usage alerts",
    "status bar",
    "llm"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Augmeter disables local coding-assistant and session-history tracking in untrusted workspaces.",
      "restrictedConfigurations": [
        "augmeter.providers.enabled",
        "augmeter.providers.enabledIds",
        "augmeter.providers.claude.path",
        "augmeter.providers.codex.path",
        "augmeter.providers.copilot.stateDbPath",
        "augmeter.providers.copilot.api.enabled",
        "augmeter.providers.copilot.api.username"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "augmeter.manualRefresh",
        "title": "Refresh Assistant Activity and Credits",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.openSettings",
        "title": "Open Settings",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.signIn",
        "title": "Connect Augment",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.signOut",
        "title": "Disconnect Augment",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.copyUsageSummary",
        "title": "Copy Augment Credit Summary",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.openUsageDashboard",
        "title": "Open Assistant Usage",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.exportUsageHistoryCsv",
        "title": "Export Augment Credit History (CSV)",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.exportUsageBundleJson",
        "title": "Export All Usage Data (JSON)",
        "category": "Augmeter"
      },
      {
        "command": "augmeter.runDiagnostics",
        "title": "Copy Diagnostics",
        "category": "Augmeter"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "augmeter.signIn",
          "when": "!augmeter.isSignedIn"
        },
        {
          "command": "augmeter.signOut",
          "when": "augmeter.isSignedIn"
        },
        {
          "command": "augmeter.copyUsageSummary",
          "when": "augmeter.isSignedIn"
        },
        {
          "command": "augmeter.openUsageDashboard"
        },
        {
          "command": "augmeter.exportUsageHistoryCsv",
          "when": "augmeter.isSignedIn"
        },
        {
          "command": "augmeter.exportUsageBundleJson"
        },
        {
          "command": "augmeter.runDiagnostics"
        }
      ]
    },
    "configuration": [
      {
        "title": "Augmeter: Assistant activity",
        "properties": {
          "augmeter.providers.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Track local activity from selected coding assistants in the tooltip, assistant usage view, and exports. Local reading is off in untrusted workspaces."
          },
          "augmeter.providers.enabledIds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "claude",
                "codex",
                "copilot"
              ]
            },
            "default": [
              "claude",
              "codex",
              "copilot"
            ],
            "description": "Choose which coding assistants Augmeter tracks locally. Augment credit collection is configured separately."
          },
          "augmeter.providers.claude.path": {
            "type": "string",
            "default": "",
            "description": "Override the local Claude Code log path. Leave blank to use ~/.claude/projects."
          },
          "augmeter.providers.codex.path": {
            "type": "string",
            "default": "",
            "description": "Override the local Codex session path. Leave blank to use ~/.codex/sessions."
          },
          "augmeter.providers.copilot.stateDbPath": {
            "type": "string",
            "default": "",
            "description": "Override the VS Code database used for local Copilot request counts. Leave blank to use the platform default."
          },
          "augmeter.providers.copilot.api.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Read official Copilot premium-request usage from GitHub. Uses GITHUB_TOKEN and falls back to local VS Code counts if unavailable."
          },
          "augmeter.providers.copilot.api.username": {
            "type": "string",
            "default": "",
            "description": "GitHub username whose Copilot premium-request usage Augmeter should read."
          }
        }
      },
      {
        "title": "Augmeter: Augment credits",
        "properties": {
          "augmeter.dataSource": {
            "type": "string",
            "enum": [
              "auto",
              "auggie-cli",
              "cookie"
            ],
            "enumDescriptions": [
              "Prefer the Auggie CLI when installed and signed in; fall back to the session cookie.",
              "Only use the Auggie CLI (auggie account status).",
              "Only use a session cookie stored in VS Code SecretStorage."
            ],
            "default": "auto",
            "description": "Choose how Augmeter reads Augment credits.",
            "scope": "application"
          },
          "augmeter.auggieCli.path": {
            "type": "string",
            "default": "",
            "description": "Override the Auggie CLI path. Augmeter runs this binary to read credit information, so choose only a trusted installation. Leave blank to detect it automatically.",
            "scope": "application"
          },
          "augmeter.apiBaseUrl": {
            "type": "string",
            "default": "https://app.augmentcode.com/api",
            "description": "Advanced: Augment API base URL. Change only for a known Augment environment.",
            "scope": "application"
          },
          "augmeter.history.retentionDays": {
            "type": "number",
            "default": 35,
            "minimum": 7,
            "maximum": 90,
            "description": "Keep local Augment credit history for trends and CSV exports (7-90 days)."
          },
          "augmeter.alerts.warningPercent": {
            "type": "number",
            "default": 75,
            "minimum": 50,
            "maximum": 99,
            "description": "Notify when Augment credit use reaches this warning threshold."
          },
          "augmeter.alerts.highPercent": {
            "type": "number",
            "default": 90,
            "minimum": 60,
            "maximum": 99,
            "description": "Notify when Augment credit use reaches this high threshold."
          },
          "augmeter.alerts.criticalPercent": {
            "type": "number",
            "default": 95,
            "minimum": 70,
            "maximum": 100,
            "description": "Notify when Augment credit use reaches this critical threshold."
          },
          "augmeter.alerts.runOutDays": {
            "type": "number",
            "default": 3,
            "minimum": 0,
            "maximum": 30,
            "description": "Warn when Augment credits may run out within this many days. Use 0 to turn off this alert."
          },
          "augmeter.budget.cycleTarget": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "Set a personal credit target for the current Augment billing cycle. Use 0 to turn off target tracking."
          },
          "augmeter.budget.monthlyTarget": {
            "type": "number",
            "minimum": 0,
            "deprecationMessage": "Use augmeter.budget.cycleTarget. Existing values continue to work until you set the new option.",
            "description": "Deprecated: personal Augment credit target."
          },
          "augmeter.smartSignIn.quickWatchMs": {
            "type": "number",
            "default": 2000,
            "minimum": 0,
            "maximum": 5000,
            "description": "Advanced: clipboard watch time before opening Augment, in milliseconds. Use 0 to skip this step.",
            "scope": "application"
          },
          "augmeter.smartSignIn.websiteWatchMs": {
            "type": "number",
            "default": 300000,
            "minimum": 1000,
            "maximum": 300000,
            "description": "Advanced: clipboard watch time after opening Augment, in milliseconds.",
            "scope": "application"
          }
        }
      },
      {
        "title": "Augmeter: Status bar",
        "properties": {
          "augmeter.clickAction": {
            "type": "string",
            "enum": [
              "refresh",
              "openWebsite",
              "openSettings"
            ],
            "enumDescriptions": [
              "Refresh assistant activity and credits",
              "Open the Augment website",
              "Open Augmeter settings"
            ],
            "default": "refresh",
            "description": "Choose what happens when you click connected Augment credit data in the status bar. When Augment is disconnected, clicking opens Assistant usage."
          },
          "augmeter.showInStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "Show Augmeter in the VS Code status bar."
          }
        }
      },
      {
        "title": "Augmeter: General",
        "properties": {
          "augmeter.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Track selected coding assistants and, when connected, Augment credits."
          },
          "augmeter.refreshInterval": {
            "type": "number",
            "default": 60,
            "description": "Refresh assistant activity and connected usage at this interval while VS Code is focused (1-300 seconds).",
            "minimum": 1,
            "maximum": 300
          },
          "augmeter.backgroundMultiplier": {
            "type": "number",
            "default": 5,
            "description": "Refresh less often while VS Code is in the background. For example, 5 turns a 60-second interval into 5 minutes. Use 1 for no slowdown.",
            "minimum": 1,
            "maximum": 20
          },
          "augmeter.logLevel": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info"
            ],
            "default": "info",
            "description": "Log detail shown in Output > Augmeter."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "compile-tests": "npm run clean && tsc -p ./tsconfig.test.json",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package",
    "clean": "rimraf --glob out \"*.vsix\"",
    "sbom": "cyclonedx-npm --output-file sbom.json",
    "pretest": "npm run compile && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:unit": "vitest run src/unit",
    "test:integration": "npm run compile-tests && vscode-test",
    "test:all": "npm run test:cov && npm run test:integration",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "analyze:knip": "knip --reporter json --no-progress"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.{js,mjs}": [
      "prettier --write"
    ]
  }
}

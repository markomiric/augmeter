{
  "version": "1.0",
  "description": "Agent activation rules for the augmeter TypeScript VS Code extension. Maps agent types to trigger keywords and intent patterns for intelligent routing.",
  "agents": {
    "code-simplifier": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Simplifies and refines code for clarity, consistency, and maintainability while preserving all functionality. Focuses on recently modified code unless instructed otherwise.",
      "promptTriggers": {
        "keywords": [
          "simplify",
          "refactor",
          "clean up",
          "code quality",
          "maintainability",
          "clarity",
          "consistency",
          "reduce complexity",
          "DRY",
          "readability",
          "code review",
          "polish",
          "tidy",
          "clean code",
          "code smell",
          "extract function",
          "rename",
          "consolidate",
          "dead code",
          "unused code",
          "redundant"
        ],
        "intentPatterns": [
          "(simplify|clean up|refactor).*?(code|function|component)",
          "(improve|enhance).*?(readability|clarity|maintainability)",
          "(reduce|remove).*?(complexity|duplication|redundancy)",
          "(dead|unused).*?(code|import|variable)",
          "code.*?(quality|smell|review)",
          "(tidy|polish|consolidate).*?(code|file|module)",
          "(extract|rename|inline).*?(function|variable|method)"
        ]
      }
    },
    "debugger-detective": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Systematic debugging, root cause analysis, and solving persistent technical issues",
      "promptTriggers": {
        "keywords": [
          "debug",
          "debugging",
          "bug",
          "error",
          "issue",
          "problem",
          "crash",
          "not working",
          "broken",
          "fix",
          "fix this",
          "root cause",
          "trace",
          "stack trace",
          "exception",
          "failure",
          "intermittent",
          "flaky",
          "reproduce",
          "symptoms",
          "undefined",
          "null",
          "why is"
        ],
        "intentPatterns": [
          "(debug|investigate|trace).*?(error|bug|issue|problem)",
          "(find|identify).*?(root cause|issue|bug|problem)",
          "(why|how).*?(not working|failing|broken|crashing)",
          "(intermittent|flaky|random).*?(bug|error|failure)",
          "(can't|cannot).*?(reproduce|find|fix)",
          "(crash|error|exception).*?(randomly|sometimes|on activation)",
          "fix this.*?(error|issue|bug)",
          "what.*?(went wrong|is broken|is failing)"
        ]
      }
    },
    "deep-researcher": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "External internet research for technology evaluation, best practices, and online documentation analysis",
      "promptTriggers": {
        "keywords": [
          "research",
          "web search",
          "internet research",
          "documentation",
          "best practices",
          "compare",
          "comparison",
          "evaluate",
          "technology",
          "library",
          "trends",
          "industry",
          "standard",
          "pros and cons",
          "analyze and fetch",
          "study",
          "look at how"
        ],
        "intentPatterns": [
          "(research|find|search).*?(best practices|documentation|library)",
          "(compare|evaluate).*?(technology|library|framework|tool)",
          "(what are|what is).*?(best|recommended|current).*?(practice|approach)",
          "(online|web|internet).*?(research|search|documentation)",
          "(latest|current).*?(trends|practices|standards)",
          "pros.*?cons",
          "(look at|study).*?how.*?(does|works|implements)",
          "analyze.*?fetch.*?(implementation|pattern|code)",
          "(send|dispatch).*?(researcher|research agent)"
        ]
      }
    },
    "master-orchestrator": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "critical",
      "description": "Comprehensive codebase analysis, strategic planning, and technical task enrichment for complex multi-step tasks",
      "promptTriggers": {
        "keywords": [
          "plan",
          "planning",
          "strategy",
          "strategic",
          "architecture",
          "orchestrate",
          "coordinate",
          "complex task",
          "multi-step",
          "multi-phase",
          "breakdown",
          "analyze codebase",
          "implementation plan",
          "technical plan",
          "roadmap",
          "sprint",
          "phase",
          "Phase 1",
          "Phase 2",
          "Phase 3",
          "master orchestrator",
          "master-orchestrator",
          "master orc",
          "plan it out",
          "planned out",
          "next steps",
          "batch of work"
        ],
        "intentPatterns": [
          "(plan|design).*?(implementation|architecture|feature)",
          "(complex|multi-step|multi-phase).*?(task|implementation|feature)",
          "(break down|breakdown|decompose).*?(task|feature|requirement)",
          "(strategic|comprehensive).*?(analysis|planning|approach)",
          "(coordinate|orchestrate).*?(agents|specialists|work)",
          "(codebase|architecture).*?(analysis|assessment|planning)",
          "(request|invoke|launch).*?master.*?orchestrator",
          "Phase.*?(planning|implementation|execution)",
          "let's start.*?(discussing|planning|with)",
          "(next|upcoming).*?(steps|phase|batch|work)",
          "plan it out.*?(execute|then)"
        ]
      }
    },
    "performance-optimizer": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Performance analysis for VS Code extension activation time, status-bar polling/refresh cost, subprocess and I/O efficiency, .vsix package size, and memory/dispose hygiene",
      "promptTriggers": {
        "keywords": [
          "performance",
          "optimize",
          "optimization",
          "slow",
          "speed",
          "activation time",
          "startup",
          "polling",
          "refresh interval",
          "bundle size",
          "package size",
          "lazy loading",
          "caching",
          "memory",
          "memory leak",
          "dispose",
          "subprocess",
          "CPU",
          "bottleneck",
          "profiling",
          "performance review"
        ],
        "intentPatterns": [
          "(optimize|improve).*?(performance|speed|activation|startup)",
          "(slow|sluggish|laggy).*?(activation|extension|command|polling|fetch)",
          "(reduce|minimize).*?(bundle|package|size|activation time|.vsix)",
          "(memory|CPU).*?(usage|leak|optimization)",
          "(profile|analyze).*?(performance|bottleneck)",
          "(dispose|cleanup|leak).*?(handler|listener|interval|resource)",
          "(use|spawn|invoke).*?performance.*?(agent|optimizer)",
          "performance.*?review"
        ]
      }
    },
    "quality-engineer": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Proactive quality enforcement with Vitest unit tests, @vscode/test-cli extension-host tests, coverage thresholds, ESLint/Prettier gates, and focused regression coverage",
      "promptTriggers": {
        "keywords": [
          "test",
          "testing",
          "TDD",
          "unit test",
          "integration test",
          "extension-host test",
          "Vitest",
          "vscode-test",
          "ESLint",
          "Prettier",
          "coverage",
          "coverage threshold",
          "quality",
          "QA",
          "assertion",
          "mock",
          "stub",
          "fixture",
          "verify",
          "validate"
        ],
        "intentPatterns": [
          "(write|create|add).*?(test|tests|testing)",
          "(unit|integration|extension-host).*?(test|testing)",
          "(test|testing).*?(coverage|strategy|approach)",
          "(TDD|test-driven).*?(development|approach)",
          "(quality|QA).*?(enforcement|assurance|validation)",
          "(Vitest|vscode-test|ESLint|Prettier|coverage).*?(test|setup|configuration|failure|gate)",
          "(verify|validate).*?(implementation|behavior|functionality)"
        ]
      }
    },
    "security-auditor": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Security reviews for the VS Code extension: secret/cookie/token handling (SecretStorage, never logging credentials), subprocess and input safety, VS Code API surface, supply-chain/dependency risk, and OWASP concerns",
      "promptTriggers": {
        "keywords": [
          "security",
          "vulnerability",
          "audit",
          "OWASP",
          "injection",
          "XSS",
          "secret",
          "secrets",
          "credentials",
          "cookie",
          "token",
          "SecretStorage",
          "logging credentials",
          "subprocess",
          "command injection",
          "dependency risk",
          "supply chain",
          "expose",
          "sensitive",
          "access control"
        ],
        "intentPatterns": [
          "(security|vulnerability).*?(audit|review|assessment)",
          "(check|validate|verify).*?(security|secret|token|cookie)",
          "(OWASP|XSS|injection|command injection).*?(compliance|prevention|check)",
          "(secure|harden).*?(extension|command|subprocess|storage)",
          "(secret|token|cookie|credential).*?(storage|handling|leak|expose|log)",
          "(dependency|supply chain).*?(risk|audit|vulnerability)",
          "(subprocess|execFile|spawn).*?(safety|injection|review)"
        ]
      }
    },
    "session-librarian": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "low",
      "description": "Session file organization, consolidation, and cleanup in .claude/tasks/",
      "promptTriggers": {
        "keywords": [
          "session file",
          "session cleanup",
          "session organization",
          "consolidate sessions",
          "archive session",
          "tasks folder",
          "session management",
          "clean up sessions",
          "organize sessions",
          "conclude the session",
          "new session"
        ],
        "intentPatterns": [
          "(clean up|organize|consolidate).*?session",
          "(session|tasks).*?(file|folder|cleanup|organization)",
          "(archive|move).*?session",
          "(too many|clutter).*?session",
          "(conclude|finish|end).*?(current|this).*?session",
          "start.*?new.*?session"
        ]
      }
    },
    "visual-explainer": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "HTML visualization generation for plans, diffs, project recaps, architecture diagrams, and data tables. Produces self-contained HTML with Mermaid, CSS Grid, styled tables, Google Fonts, light/dark themes.",
      "promptTriggers": {
        "keywords": [
          "visualize",
          "visualization",
          "visual",
          "diagram",
          "architecture diagram",
          "flowchart",
          "sequence diagram",
          "data flow",
          "ER diagram",
          "state machine",
          "mind map",
          "data table",
          "timeline",
          "dashboard",
          "plan review",
          "diff review",
          "project recap",
          "HTML diagram",
          "mermaid",
          "visual explainer",
          "render as HTML",
          "comparison table",
          "view plan"
        ],
        "intentPatterns": [
          "(visualize|diagram|draw|render|illustrate).*?(architecture|system|flow|pipeline|schema|plan)",
          "(generate|create|make).*?(diagram|visualization|flowchart|chart|HTML)",
          "(review|visualize|view).*?(plan|diff|changes|implementation)",
          "(comparison|audit|matrix|report).*?(table|view|visual)",
          "/view.*?"
        ]
      }
    },
    "docs-automation-specialist": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Documentation automation, README/CHANGELOG/CLAUDE synchronization, TypeDoc API references, generated docs, doc drift checks, and docs quality gates",
      "promptTriggers": {
        "keywords": [
          "docs automation",
          "documentation automation",
          "README",
          "docs",
          "API reference",
          "changelog",
          "CHANGELOG",
          "release notes",
          "TypeDoc",
          "architecture docs",
          "generated docs",
          "doc sync",
          "documentation update",
          "docs quality"
        ],
        "intentPatterns": [
          "(create|update|generate).*?(docs|documentation|README|API reference|changelog)",
          "(sync|align).*?(docs|documentation|README|examples)",
          "(document|explain).*?(architecture|workflow|API|setup)",
          "(release notes|changelog).*?(generate|update|prepare)",
          "(docs|documentation).*?(automation|quality|gate|audit)"
        ]
      }
    }
  },
  "notes": {
    "enforcement_types": {
      "suggest": "Agent suggestion appears but doesn't block execution",
      "block": "Requires agent to be used before proceeding (guardrail)",
      "warn": "Shows warning but allows proceeding"
    },
    "priority_levels": {
      "critical": "Highest - Always trigger when matched (e.g., master-orchestrator for complex planning)",
      "high": "Important - Trigger for most matches (e.g., testing, security, performance, debugging)",
      "medium": "Moderate - Trigger for clear matches (e.g., research, docs automation, simplification)",
      "low": "Optional - Trigger only for explicit matches (e.g., session-librarian)"
    },
    "common_invocation_patterns": {
      "spawn": "spawn the X to...",
      "invoke": "invoke the X with...",
      "use": "we can use the X agent for that",
      "dispatch": "dispatch agents in parallel",
      "launch": "launch a X agent",
      "request": "request a X or a series of sub-agents",
      "send": "send another subagent into...",
      "execute": "execute a X agent and a Y agent in parallel"
    },
    "agent_overview": {
      "code-simplifier": "Code simplification, refactoring for clarity, consistency, maintainability, dead code removal",
      "debugger-detective": "Systematic debugging, root cause analysis, persistent issues, error investigation",
      "deep-researcher": "External internet research, technology evaluation, best practices comparison",
      "master-orchestrator": "Strategic planning, phase management, task enrichment, codebase analysis",
      "performance-optimizer": "Extension activation time, polling/refresh cost, subprocess/I/O efficiency, .vsix package size, memory/dispose hygiene",
      "quality-engineer": "Vitest, @vscode/test-cli extension-host tests, coverage thresholds, ESLint/Prettier gates, regression coverage",
      "security-auditor": "Secret/cookie/token handling, SecretStorage, subprocess/input safety, VS Code API surface, dependency risk, OWASP",
      "session-librarian": "Session file organization, consolidation, archiving",
      "visual-explainer": "HTML visualizations - plan reviews, diff reviews, project recaps, architecture diagrams, data tables. Self-contained HTML with Mermaid, CSS Grid, Google Fonts, light/dark themes.",
      "docs-automation-specialist": "Documentation automation, README/CHANGELOG/TypeDoc sync, doc drift checks, docs quality gates"
    }
  }
}

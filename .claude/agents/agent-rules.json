    "backend-engineer": {
      "type": "agent",
      "enforcement": "suggest",
      "priority": "high",
      "description": "FastAPI routes, AWS Lambda/API Gateway handlers, Cognito/JWT auth, DynamoDB access through UserStore/ConversationStore/BillingStore, Serverless deployment, and backend architecture",
      "promptTriggers": {
        "keywords": [
          "FastAPI",
          "API",
          "API route",
          "endpoint",
          "backend",
          "middleware",
          "authentication",
          "authorization",
          "Cognito",
          "JWT",
          "Authorization",
          "data model",
          "schema",
          "CRUD",
          "REST",
          "DynamoDB",
          "UserStore",
          "ConversationStore",
          "BillingStore",
          "boto3",
          "query",
          "mutation",
          "server-side",
          "AWS Lambda",
          "Lambda",
          "API Gateway",
          "Mangum",
          "Serverless",
          "serverless.yml",
          "services/backend"
        ],
        "intentPatterns": [
          "(create|build|implement).*?(API|endpoint|route|handler)",
          "(FastAPI|Lambda|API Gateway|Serverless).*?(route|handler|middleware|deploy|configuration)",
          "(server|backend).*?(logic|operation|workflow)",
          "(database|data).*?(operation|query|model|schema)",
          "(implement|setup|configure).*?(authentication|authorization|middleware|Cognito|JWT)",

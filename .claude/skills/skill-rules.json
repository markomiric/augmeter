          "skills folder",
          "tasks folder",
          "which agent",
          "specialist"
        ],
        "intentPatterns": [
          "(where is|where are|find|locate).*?(file|component|function|class|agent|skill|folder)",
          "(understand|explain|show).*?(structure|architecture|organization|layout)",
          "(explore|navigate).*?(codebase|project)",
          "how.*?(organized|structured|arranged)",
          "(search for|looking for).*?(pattern|code|implementation)",
          "which.*?(agent|specialist).*?(handles|does|for)"

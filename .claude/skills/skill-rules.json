{
  "version": "1.0",
  "description": "Skill activation rules for the augmeter TypeScript VS Code extension. Contains repo-specific plus core/general workflow skills.",
  "skills": {
    "agentic-builder": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Create and iteratively improve Claude Code skills, sub-agents, and slash commands. Covers skill eval loops, agent creation, and command builder.",
      "promptTriggers": {
        "keywords": [
          "create skill",
          "build skill",
          "new skill",
          "create agent",
          "build agent",
          "new agent",
          "create command",
          "build command",
          "new command",
          "slash command",
          "skill creation",
          "agent creation",
          "command creation",
          "agentic builder",
          "skill eval",
          "eval loop",
          "skill improvement",
          "agent template",
          "command template",
          "SKILL.md",
          "agent.md",
          "command.md",
          "sub-agent",
          "skill builder",
          "command builder"
        ],
        "intentPatterns": [
          "(create|build|make|generate).*?(skill|agent|command|sub-agent)",
          "(skill|agent|command).*?(creation|builder|template|eval)",
          "(improve|optimize|iterate).*?(skill|agent|command)",
          "(new|add).*?(skill|agent|command|slash command)",
          "agentic.*?builder",
          "(eval|benchmark|test).*?skill",
          "turn.*?into.*?(skill|agent|command)"
        ]
      }
    },
    "codebase-navigation": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Codebase structure, directory layout, agent specializations, and efficient navigation tips",

          "staged",
          "staging",
          "branch",
          "merge",
          "commit format",
          "commit type",
          "multi-commit",
          "check in",
          "check-in"
        ],
        "intentPatterns": [
          "(create|make|write|generate).*?commit",
          "(git|version).*?(commit|push)",
          "(session|work).*?(commit|save|check in)",

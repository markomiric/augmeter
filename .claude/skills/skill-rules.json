  "notes": {
    "enforcement_types": {
      "suggest": "Skill suggestion appears but doesn't block execution",
      "block": "Requires skill to be used before proceeding (guardrail)",
      "warn": "Shows warning but allows proceeding"
    },
    "priority_levels": {
      "critical": "Highest - Always trigger when matched (e.g., sub-agent-invocation before Task tool)",
      "high": "Important - Trigger for most matches (e.g., session-management, git-commits)",
      "medium": "Moderate - Trigger for clear matches (e.g., skill creation, tooling)",
      "low": "Optional - Trigger only for explicit matches"
    },
    "skill_overview": {
      "agentic-builder": "Skill/agent/command creation - triggers on creating skills, agents, slash commands. Covers eval loops, iterative improvement, template generation, benchmarking.",
      "codebase-navigation": "Exploration - triggers on finding, searching, understanding structure, directories, agents, specialists",
      "documentation-research": "Library docs and skills registries - triggers on documentation requests, Context7, ctx7 CLI, skills.sh, API references, skill installation",
      "git-commits": "Version control - triggers on explicit commits, pushes, save work, branch operations, scoped staging, and commit messages.",
      "session-management": "Core workflow - triggers on implementation, features, bugs, refactoring, plus all 6 session types (development, debugging, migration, review, TDD, research)",
      "sub-agent-invocation": "Critical coordination - triggers before ANY agent/Task tool usage, parallel/sequential dispatch, resumable persistent sub-agents (SendMessage), handoffs, specialist routing",
      "visual-explainer": "Visual HTML generation - triggers on diagrams, architecture overviews, flowcharts, plan reviews, comparison tables, data visualizations. Produces self-contained HTML files with Mermaid diagrams, CSS Grid layouts, styled tables, Google Fonts, light/dark themes, staggered animations.",
      "agent-operating-protocol": "Shared agent protocol - Think Hard, Skill-First startup, source-first work, scoped tool use, handoff contract, evidence-before-completion gate.",
      "codestats": "CodeStats - local dependency graph, impact analysis, risk scoring, dead code detection, communities, circular dependencies, architecture wiki.",
      "docs-automation": "Documentation automation - README/CHANGELOG/TypeDoc sync, release notes, generated docs and quality gates."
    }

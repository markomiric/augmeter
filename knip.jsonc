{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/test/**/*.test.ts", ".vscode-test.mjs"],
  "project": ["src/**/*.ts"],
  "ignore": [".claude/**"],
  // @vscode/test-cli imports @vscode/test-electron at runtime without
  // declaring it as a dependency, so the explicit devDependency is required.
  "ignoreDependencies": ["@vscode/test-electron"],
  // Exported types describe public function signatures and feed TypeDoc.
  "includeEntryExports": false,
  "rules": {
    "types": "off",
  },
}

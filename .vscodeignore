# Files excluded from the .vsix package. The package ships out/, package.json,
# README.md, CHANGELOG.md, LICENSE, and images/icon.png.

# Source (compiled to out/) and source maps
src/**
**/*.ts
**/*.map

# Compiled tests (defensive; the package script cleans out/ first)
out/test/**
out/unit/**

# Tests & coverage
test-setup/**
coverage/**
.vscode-test/**
report/**
**/*.test.*

# Dev/build configuration
tsconfig*.json
eslint.config.*
.prettierrc.json
.prettierignore
vitest.config.ts
.vscode-test.mjs
knip.jsonc
typedoc.json
justfile
package-lock.json
.npmignore

# Agent/dev assets
.claude/**
.agents/**
.codex/**
.augment/**
CLAUDE.md
plans/**

# Repo meta & CI
.github/**
.husky/**
.vscode/**
.gitignore
.gitattributes

# Generated artifacts & docs
sbom.json
docs/**
*.vsix

# Development-only packages (the extension has no runtime dependencies)
node_modules/**

# Environment & secrets
.env*
*.pem
*.key

# OS/editor files
.DS_Store
._*
Thumbs.db
*.swp
*~

# Logs
*.log
